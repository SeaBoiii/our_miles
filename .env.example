# GitHub Pages / browser Supabase mode (recommended for this deployment).
# These two values are public. Use ONLY a publishable key (sb_publishable_...).
# Configure Auth + both database migrations before using a real wallet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local Pages build defaults to /our_miles; GitHub Actions derives this automatically.
NEXT_PUBLIC_BASE_PATH=

# The variables below are optional Node-server mode, NOT GitHub Pages settings.
# With no browser configuration and both private settings empty, this is a sample-data demo.
# A partial private configuration fails closed.
# Set a new private 6–12 digit PIN and a random secret of at least 32 characters.
# Never prefix either value with NEXT_PUBLIC_. Never commit .env.local.
OUR_MILES_PIN=
OUR_MILES_SESSION_SECRET=

# Optional canonical HTTPS origin (recommended when served behind a proxy).
OUR_MILES_PUBLIC_ORIGIN=

# Optional persistent volume path. Defaults to .our-miles inside this project.
# One Node server process only. Serverless filesystems are NOT durable storage.
OUR_MILES_DATA_DIR=

# Optional hosted storage. Apply supabase/migrations/202610050001_private_wallet.sql.
# Use a NEW Supabase server secret key (sb_secret_...), never a publishable key.
# Both settings are required. They are read only by authenticated server routes.
OUR_MILES_SUPABASE_URL=
OUR_MILES_SUPABASE_SECRET_KEY=

# Set true only when your proxy overwrites X-Forwarded-For and blocks direct access.
# Otherwise all household sign-in attempts share the conservative rate limit.
OUR_MILES_TRUST_PROXY=false
